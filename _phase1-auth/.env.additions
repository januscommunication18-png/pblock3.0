# =====================================================================
# Phase 1 auth — .env additions
# Append these to your Laravel .env (and mirror keys into .env.example).
# =====================================================================

APP_URL=http://localhost:8888        # your MAMP URL (adjust host/port)

# ---- Mail --------------------------------------------------------------
# LOCAL: don't send anything real; the capture listener stores a copy for /emaillog.
MAIL_MAILER=log
MAIL_CAPTURE_TO_DB=true
MAIL_FROM_ADDRESS="hello@projectblock.test"
MAIL_FROM_NAME="Project Block"

# PRODUCTION (set these on the server instead):
# MAIL_MAILER=postmark
# MAIL_CAPTURE_TO_DB=false
# POSTMARK_TOKEN=your-postmark-server-token
# MAIL_FROM_ADDRESS="hello@yourdomain.com"
# MAIL_FROM_NAME="Project Block"

# ---- File storage / avatars -------------------------------------------
# LOCAL: store avatars in public/assets (disk "assets"); served at /assets/...
AVATAR_DISK=assets

# PRODUCTION: DigitalOcean Spaces (S3-compatible)
# AVATAR_DISK=spaces
# DO_SPACES_KEY=xxxxxxxx
# DO_SPACES_SECRET=xxxxxxxx
# DO_SPACES_REGION=nyc3
# DO_SPACES_BUCKET=your-bucket
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_URL=https://your-bucket.nyc3.cdn.digitaloceanspaces.com

# ---- OAuth (Laravel Socialite) ----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"
