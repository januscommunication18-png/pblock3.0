APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Outbound mail --------------------------------------------------------
# Local default is `log`: nothing leaves the machine, and invitations are written
# to storage/logs. Keep it that way locally — WorkspaceInviter sends with
# `sendNow`, so a real transport here means a real email every time you exercise
# the invite flow or the Help Center setup wizard.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Outbound mail: Postmark SMTP (DEV / staging / production) -------------
# Replace the block above with this on a deployed server. Postmark accepts the
# Server API Token as BOTH the SMTP username and password.
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.postmarkapp.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<postmark-server-api-token>
#   MAIL_PASSWORD=<postmark-server-api-token>
#   MAIL_FROM_ADDRESS=no-reply@myprojectblock.dev
#   MAIL_FROM_NAME="ProjectBlock DEV"
#
# NOTE: do NOT set MAIL_ENCRYPTION. That was the Laravel 10 key; this app is on
# Laravel 13, whose smtp mailer reads MAIL_SCHEME (see config/mail.php), and an
# MAIL_ENCRYPTION line is read by nothing at all. Leave MAIL_SCHEME unset or
# `null` and port 587 negotiates STARTTLS on its own. Only set MAIL_SCHEME=smtps
# if you move to implicit TLS on port 465.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Access gate (Dev/UAT "secure page") ------------------------------------
# Holds the site behind a code screen so a non-production copy is not public.
# Unset = on in the environments listed below, off everywhere else. Never runs
# in production, whatever this is set to.
ACCESS_GATE_ENABLED=
ACCESS_GATE_ENVIRONMENTS=local,development,dev,uat,staging
ACCESS_GATE_CODES=1000,2000,3000,4000,5000

# ---- Icon set --------------------------------------------------------------
# legacy      the hand-drawn inline SVGs the app shipped with (default)
# fontawesome Font Awesome Pro 7 Classic Regular, self-hosted
# Switching is this value alone — no markup changes either way.
ICONS_SET=legacy

# Jodit Pro licence key for the Pages editor. Without it the Pro plugins load but stay inert,
# which looks like the Pro features are missing rather than like an error.
JODIT_LICENSE=

# ---- Help Center inbound email ----------------------------------------------
# Every Help Center inbox is generated a unique inbound address on this domain,
# which customers forward their own support address to (docs/features/help-center.md
# §8). Deployment-specific; the addresses themselves are generated and read-only.
#
# The inbound WEBHOOK settings that used to sit here went with the archived module
# (legacy/help-desk). Nothing receives mail at these addresses yet — that endpoint
# is the next phase, and it will bring the variables it actually needs rather than
# inheriting a block written for an implementation that no longer exists.
HELP_CENTER_INBOUND_DOMAIN=inbound.projectblock.app

# The local part of a generated address: `<prefix>-<token>@<domain>`.
HELP_CENTER_INBOUND_PREFIX=inbox

# ---- Inbound mail: Postmark Inbound ----------------------------------------
# The webhook that receives forwarded customer email:
#
#   POST /api/webhooks/postmark/inbound/{token?}
#
# Postmark does NOT sign inbound webhooks, so this shared secret is the only
# thing protecting the endpoint. Generate one with `php artisan key:generate
# --show` and give Postmark EITHER shape of URL:
#
#   https://myprojectblock.dev/api/webhooks/postmark/inbound/<secret>
#   https://postmark:<secret>@myprojectblock.dev/api/webhooks/postmark/inbound
#
# LEAVE IT EMPTY AND THE ENDPOINT REFUSES EVERYTHING. That is deliberate — an
# unset secret must never mean an open endpoint.
HELP_CENTER_INBOUND_SECRET=

# On the DEV server the generated addresses must sit on the domain Postmark is
# actually receiving for, or nothing will route:
#
#   HELP_CENTER_INBOUND_DOMAIN=inbound.myprojectblock.dev
#
# Ingestion runs on the QUEUE (the webhook only enqueues), so a worker has to be
# running or nothing is processed:  php artisan queue:work
